---
import BaseLayout from './BaseLayout.astro';

interface Props {
	title?: string;
	description?: string;
	ogImage?: string;
}

const { title, description, ogImage } = Astro.props;

const navLinks = [
	{ href: '/', label: 'Home' },
	{ href: '/about', label: 'About' },
	{ href: '/blog', label: 'Blog' },
	{ href: '#', label: 'CTF Platform' },
	{ href: '#', label: 'Join 332' },
	{ href: '#', label: 'Bug Bounty' }
];
---

<BaseLayout title={title} description={description} ogImage={ogImage}>
	<nav class="universal-margin flex flex-row gap-4 font-light py-4">
		{navLinks.map(link => <a class="no-underline! hover:underline!" href={link.href}>{link.label}</a>)}
	</nav>
	<slot />
</BaseLayout>


