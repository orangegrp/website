---
import "../styles/global.css";

interface Props {
	title?: string;
	description?: string;
	ogImage?: string;
}

const {
	title = "332",
	description = "332, formerly Order 332 is an online Discord community centered around IT and cybersecurity. Today it is much more than that, though.",
	ogImage,
} = Astro.props;

function deriveOgImage(pathname: string): string {
	if (pathname === "/") return "/og/index.png";
	const segments = pathname.replace(/\/$/, "").split("/").filter(Boolean);
	if (segments[0] === "blog" && segments.length > 1) return "/og/blog.png";
	return `/og/${segments[segments.length - 1]}.png`;
}

const siteOrigin = Astro.url.origin;
const resolvedOgImage =
	siteOrigin + (ogImage ?? deriveOgImage(Astro.url.pathname));
const canonicalUrl = Astro.url.href;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta
			name="viewport"
			content="width=device-width, initial-scale=1, viewport-fit=cover"
		/>
		<link rel="icon" href="/polygon.svg" type="image/svg+xml" />
		<link rel="canonical" href={canonicalUrl} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={resolvedOgImage} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:site_name" content="332" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={resolvedOgImage} />
		<script id="Cookiebot" src="https://consent.cookiebot.com/uc.js" data-cbid="273a5781-93e3-4711-aa48-eb52520a7ff1" data-blockingmode="auto" type="text/javascript"></script>
	</head>
	<body>
		<div
			class="p-2 bg-gray-100 hover:cursor-pointer flex-col"
			id="domainHintBar"
		>
			<div class="text-xs universal-margin flex flex-row justify-between">
				<div class="flex flex-row">
					<img
						src="/polygon.svg"
						alt="332 logo"
						class="w-4 h-4 mr-2 invert"
					/>
					<span
						>An official website of the 332 community. Here's how
						you know</span
					>
				</div>
				<span id="domainToggleIcon">&#9658;</span>
			</div>
			<div
				class="font-light universal-margin my-4 hidden"
				id="domainHintDetails"
			>
				<p>
					All 332 websites are under the <i>*.order332.com</i> domain.
					<b>Never</b> share your personal information, including on this official website unless it is reasonable to do so and the connection is encrypted using <b>HTTPS</b>. If in doubt, contact your local cyber security centre or <a href="https://www.ncsc.gov.uk/collection/top-tips-for-staying-secure-online" target="_blank">learn more</a> about staying safe online.
				</p>
			</div>
		</div>
		<slot />
	</body>
	<script>
		let domainHintCollapsed: boolean = true;

		const domainBar = document.getElementById("domainHintBar");
		const domainToggleIcon = document.getElementById("domainToggleIcon");
		const detailledHint = document.getElementById("domainHintDetails");
		if (domainBar) {
			domainBar.addEventListener("click", () => {
				domainHintCollapsed = !domainHintCollapsed;
				if (domainToggleIcon && detailledHint) {
					domainToggleIcon.innerHTML = domainHintCollapsed
						? "&#9658;"
						: "&#9650;";
					detailledHint.classList.toggle(
						"hidden",
						domainHintCollapsed,
					);
				}
			});
		}
	</script>
</html>
