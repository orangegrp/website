---
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const posts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const anyPostHasTags = posts.some((p) => p.data.tags.length > 0);
---

<PageLayout
	title="Blog — 332"
	description="Rough drafts turned less rough: security notes, changelog banter, and whatever else cleared editing."
>
	<div>
		<div>
			<div>
				<h1>Blog</h1>
			</div>

			<div id="blog-filter-root">
				{posts.length > 0 && (
					<div>
						<div>
							<div role="search" aria-label="Search and filter posts by text">
								<div id="blog-active-tags" aria-label="Active tag filters"></div>
								<div>
									<label for="blog-search">Search posts</label>
									<input
										id="blog-search"
										type="text"
										inputmode="search"
										placeholder="Search posts…"
										autocomplete="off"
										enterkeyhint="search"
									/>
								</div>
							</div>
						</div>

						<div>
							<fieldset>
								<div>
									{anyPostHasTags && (
										<div>
											<div id="blog-browse-tag-buttons"></div>
											<button
												type="button"
												id="blog-tags-expand"
												hidden
												aria-expanded="false"
											>
												Show all
											</button>
										</div>
									)}
									<div>
										<div id="blog-layout-dropdown">
											<button
												type="button"
												id="blog-layout-trigger"
												aria-expanded="false"
												aria-haspopup="listbox"
												aria-controls="blog-layout-menu"
												aria-label="Post layout"
											>
												<span id="blog-layout-value">Cards</span>
												<svg
													class="blog-layout-chevron"
													xmlns="http://www.w3.org/2000/svg"
													viewBox="0 0 24 24"
													fill="none"
													stroke="currentColor"
													stroke-width="2"
													stroke-linecap="round"
													stroke-linejoin="round"
													aria-hidden="true"
												>
													<path d="m6 9 6 6 6-6" />
												</svg>
											</button>
											<div
												id="blog-layout-menu"
												role="listbox"
												aria-labelledby="blog-layout-trigger"
											>
												<button
													type="button"
													class="blog-layout-option"
													data-layout="cards"
													aria-selected="true"
												>
													Cards
												</button>
												<button
													type="button"
													class="blog-layout-option"
													data-layout="list"
													aria-selected="false"
												>
													List
												</button>
											</div>
										</div>
									</div>
								</div>
							</fieldset>
						</div>
					</div>
				)}

				{posts.length > 0 ? (
					<>
						<p id="blog-filter-empty" hidden role="status">
							No posts match your search or selected tags.
						</p>
						<div id="blog-posts-container" class="blog-posts-grid">
							{posts.map(post => (
								<div
									class="blog-post-item"
									data-blog-tags={JSON.stringify(post.data.tags)}
									data-blog-title={post.data.title}
									data-blog-description={post.data.description}
								>
									<a href={`/blog/${post.id}`}>
										<div>
											<time datetime={post.data.date.toISOString()}>
												{new Intl.DateTimeFormat("en-US", {
													year: "numeric",
													month: "short",
													day: "numeric",
												}).format(post.data.date)}
											</time>
											{post.data.author && (
												<>
													<span>·</span>
													<span>{post.data.author}</span>
												</>
											)}
										</div>
										<h3>{post.data.title}</h3>
										<p>{post.data.description}</p>
										{post.data.tags.length > 0 && (
											<div>
												{post.data.tags.map((tag) => (
													<span>{tag}</span>
												))}
											</div>
										)}
										<div>Read post →</div>
									</a>
								</div>
							))}
						</div>
					</>
				) : (
					<div>
						<p>Quiet for now.</p>
						<p>Posts will appear here when published.</p>
					</div>
				)}
			</div>
		</div>
	</div>

	<footer>
		<div>
			<div>
				<img src="/polygon.svg" alt="332" width="20" height="20" />
				<span>332</span>
			</div>
			<div>
				<a href="/">Home</a>
				<a href="/about">About</a>
				<a href="/blog">Blog</a>
			</div>
			<p>© {new Date().getFullYear()} 332</p>
		</div>
	</footer>
</PageLayout>

<script>
	import { initBlogToolbar } from '../../scripts/blog-toolbar';
	initBlogToolbar();
</script>
