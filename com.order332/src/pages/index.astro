---
import { getCollection } from "astro:content";
import PageLayout from "../layouts/PageLayout.astro";

const posts = await getCollection("blog", ({ data }) => !data.draft);
const latestPosts = posts
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
	.slice(0, 3);
---

<PageLayout
	title="332"
>
	<div class="relative">
		<video class="absolute inset-0 w-full h-full object-cover" autoplay muted loop src="https://x571zn6ysk.ufs.sh/f/Hqd7taZdF7DE5sUBN0E3IsNzjhy1SpPi7TUGMHZaVnwoWFBX"/>
		<div class="relative z-10 bg-black/50 text-white!">
			<div class="universal-margin py-32"
			>
			<h1 class="text-5xl font-m-blem">Welcome to the 332 website</h1>
		</div>
			
		</div>
	</div>



	<section>
		<div>
			<h2>About us</h2>
			<p>
				Same origin story wherever you skim it—we just lead with
				visuals here.
			</p>

			<div>
				<iframe
					src="https://app.order332.com/share/-yCgMBOvrHb-MQ-mC553jfYsinX8ptlnzjW0xEw0DRM/embed"
					title="332 Trailer"
					loading="lazy"
					allow="autoplay; fullscreen; picture-in-picture"
					referrerpolicy="no-referrer"
					scrolling="no"
				></iframe>
			</div>
		</div>
	</section>

	{
		latestPosts.length > 0 && (
			<section>
				<div>
					<div>
						<h2>Latest from the blog</h2>
						<a href="/blog">All posts →</a>
					</div>

					<div>
						{latestPosts.map((post) => (
							<div
								data-blog-tags={JSON.stringify(post.data.tags)}
								data-blog-title={post.data.title}
								data-blog-description={post.data.description}
							>
								<a href={`/blog/${post.id}`}>
									<div>
										<time datetime={post.data.date.toISOString()}>
											{new Intl.DateTimeFormat("en-US", {
												year: "numeric",
												month: "short",
												day: "numeric",
											}).format(post.data.date)}
										</time>
										{post.data.author && (
											<>
												<span>·</span>
												<span>{post.data.author}</span>
											</>
										)}
									</div>
									<h3>{post.data.title}</h3>
									<p>{post.data.description}</p>
									{post.data.tags.length > 0 && (
										<div>
											{post.data.tags.map((tag: any) => (
												<span>{tag}</span>
											))}
										</div>
									)}
									<div>Read post →</div>
								</a>
							</div>
						))}
					</div>
				</div>
			</section>
		)
	}

	<section>
		<div>
			<h2>Invite-only community</h2>
			<p>
				332 is a private community. If you've been invited—or know
				someone who can vouch for you—use the link below to join. If you
				don't have an invite but are interested in joining, you can also
				apply using the same link.
			</p>

			<div>
				<a
					href="https://discord.gg/WuGrkMZeNG"
					target="_blank"
					rel="noopener noreferrer"
				>
					Join on Discord
					<svg
						xmlns="http://www.w3.org/2000/svg"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
					>
						<path
							d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"
						></path>
						<polyline points="15 3 21 3 21 9"></polyline>
						<line x1="10" y1="14" x2="21" y2="3"></line>
					</svg>
				</a>
				<a href="/about">Learn more</a>
			</div>
		</div>
	</section>

	<footer>
		<div>
			<div>
				<img src="/polygon.svg" alt="332" width="20" height="20" />
				<span>332</span>
			</div>
			<div>
				<a href="/">Home</a>
				<a href="/about">About</a>
				<a href="/blog">Blog</a>
			</div>
			<p>© {new Date().getFullYear()} 332</p>
		</div>
	</footer>
</PageLayout>
