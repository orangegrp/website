---
import PageLayout from '../layouts/PageLayout.astro';
---

<PageLayout
	title="500 — 332"
	description="Something went wrong."
>
	<div>
		<div aria-hidden="true">
			<div></div>
			<div></div>
		</div>

		<div>
			<div>
				<img
					src="/polygon.svg"
					alt="332"
					width="56"
					height="56"
				/>

				<div>
					<div>500</div>
					<h1>The server shrugged hard.</h1>
				</div>

				<p>Something went wrong on our end. It's not you. Try refreshing, or come back in a bit.</p>

				<div>
					<a href="/">Go home</a>
					<button onclick="window.location.reload()">Try again</button>
				</div>
			</div>
		</div>
	</div>
</PageLayout>
